func _animate_alpha(key: String, row: Control, target: float) -> void:
	if is_equal_approx(_target_alpha[key], target): return
	_target_alpha[key] = target
	
	if _alpha_tweens[key] and _alpha_tweens[key].is_valid():
		_alpha_tweens[key].kill()
	
	_alpha_tweens[key] = create_tween()
	_alpha_tweens[key].tween_property(row, "modulate:a", target, 0.4).set_trans(Tween.TRANS_SINE)

func _shake_row(row: Control) -> void:
	var base_pos = Vector2(0, row.position.y)
	if row.has_meta("is_shaking"): return
	row.set_meta("is_shaking", true)
	
	var t = create_tween()
	t.tween_property(row, "position", base_pos + Vector2(-15, 6), 0.03)
	t.tween_property(row, "position", base_pos + Vector2(15, -6), 0.03)
	t.tween_property(row, "position", base_pos + Vector2(-10, 4), 0.03)
	t.tween_property(row, "position", base_pos + Vector2(10, -4), 0.03)
	t.tween_property(row, "position", base_pos + Vector2(-4, 2), 0.03)
	t.tween_property(row, "position", base_pos, 0.03)
	t.tween_callback(func(): row.remove_meta("is_shaking"))

func _push_row(row: Control) -> void:
	var base_pos = Vector2(0, row.position.y)
	if row.has_meta("is_shaking"): return
	row.set_meta("is_shaking", true)
	
	var t = create_tween()
	t.tween_property(row, "position", base_pos + Vector2(-15, 0), 0.1).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	t.tween_property(row, "position", base_pos, 0.2).set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)
	t.tween_callback(func(): row.remove_meta("is_shaking"))

func refresh_hud() -> void:
	if last_hp == null or last_hp == -1:
		last_hp = manager._hp
		last_shield = manager._shield
		last_bp = manager._bp

	if manager._hp < last_hp: _shake_row(hp_row_box)
	if manager._shield < last_shield: _shake_row(shield_row_box)
	if manager._bp < last_bp: _push_row(bp_row_box)

	last_hp = manager._hp
	last_shield = manager._shield
	last_bp = manager._bp

	var is_combat = manager._combat_flag
	var target_alpha = 1.0 if is_combat else FADE_OUT_ALPHA
	
	var final_hp_alpha = 0.4 if manager._hp <= 0 else target_alpha
	var final_sh_alpha = 0.4 if manager._shield <= 0 else target_alpha
	var final_bp_alpha = target_alpha

	_animate_alpha("hp", hp_row_box, final_hp_alpha)
	_animate_alpha("shield", shield_row_box, final_sh_alpha)
	_animate_alpha("bp", bp_row_box, final_bp_alpha)

	if hp_fill != null and hp_fill.has_method("update_health"):
		hp_fill.update_health(manager._hp, manager._max_hp)

	if shield_fill != null and shield_fill.has_method("update_health"):
		shield_fill.update_health(manager._shield, manager._max_shield)

	if bp_fill != null and bp_fill.has_method("update_health"):
		bp_fill.update_health(manager._bp, manager._max_bp)
		
		if manager._bp < manager._max_bp and manager.game_state:
			var progress = manager.game_state.bp_regen_progress
			var target_ratio = (float(manager._bp) + progress) / float(manager._max_bp)
			bp_fill.set_charge_ratio(target_ratio)
			
			if bp_regen_label:
				bp_regen_label.visible = true
				var time_left = manager.game_state.bp_regen_interval - manager.game_state.bp_regen_timer
				bp_regen_label.text = "(-%.1fs)" % maxf(0.0, time_left)
		else:
			bp_fill.set_charge_ratio(0.0)
			if bp_regen_label:
				bp_regen_label.visible = false

	if burn_icon != null: burn_icon.visible = is_burning
	if burn_text != null: burn_text.visible = is_burning

	# 【v1.1】金币 / 等级 / 经验
	if gold_label != null:
		gold_label.text = "$ %d" % int(manager.game_state.gold)
	if level_label != null:
		var gs = manager.game_state
		if int(gs.current_level) >= int(gs.MAX_LEVEL):
			level_label.text = "Lv.%d (MAX)" % int(gs.current_level)
		else:
			level_label.text = "Lv.%d  经验 %d/%d" % [int(gs.current_level), int(gs.exp), int(gs.exp_to_next())]

	_refresh_quickbar()

func _skill_slot_cards() -> Array:
	if manager.bag_ui != null and manager.bag_ui.skill_slot_cards.size() == 4:
		return manager.bag_ui.skill_slot_cards
	return [-1, -1, -1, -1]

func _refresh_quickbar() -> void:
	if quick_bar == null: return
	var slots: Array = _skill_slot_cards()
	var all_cards: Array = manager._all_cards()
	for i in 4:
		var slot := quick_bar.get_child(i) as Panel
		var label := slot.get_child(0) as Label
		if slot_cd[i] > 0.0:
			slot.modulate = Color(0.45, 0.45, 0.5, 1.0)
			label.text = "冷却 %.1fs" % slot_cd[i]
			continue
		slot.modulate = Color(1, 1, 1, 1)
		var idx: int = slots[i] if i < slots.size() else -1
		if idx >= 0 and idx < all_cards.size():
			var c: Dictionary = all_cards[idx]
			label.text = "%s\nLv.%d %s" % [c["name"], c["level"], c["type"]]
		else:
			label.text = "（空槽位）"

func use_card_slot(slot_index: int) -> void:
	if slot_index < 0 or slot_index >= 4: return
	if slot_cd[slot_index] > 0.0: return
	var slots: Array = _skill_slot_cards()
	if slot_index >= slots.size(): return
	var idx: int = slots[slot_index]
	if idx < 0 or idx >= manager._all_cards().size(): return
	var c: Dictionary = manager._all_cards()[idx]

	var player = get_tree().get_first_node_in_group("player")
	if player == null or player.skills == null: return

	var skill_id := ""
	var res = c.get("res")
	if res is SkillData:
		skill_id = str(res.skill_id)
	if skill_id == "":
		skill_id = str(c.get("base_id", ""))

	var success: bool = player.skills.cast_skill(skill_id)
	if not success:
		return

	slot_cd[slot_index] = manager.SLOT_CD_TIME
	_refresh_quickbar()

func tick_slot_cooldown(delta: float) -> void:
	var any_active := false
	for i in 4:
		if slot_cd[i] > 0.0:
			slot_cd[i] = maxf(0.0, slot_cd[i] - delta)
			any_active = true
			if is_zero_approx(slot_cd[i]): slot_cd[i] = 0.0
	if any_active: _refresh_quickbar()

func _make_hud_bar(parent: Control, fill_color: Color, icon_type: String, font_size: int, delay: bool, charge: bool) -> Dictionary:
	var track = HealthBar.new()
	track.mouse_filter = Control.MOUSE_FILTER_IGNORE
	track.setup(fill_color == manager.COL_SHIELD, fill_color, delay, charge, icon_type, font_size, 10.0)
	# 【核心修改】宽度缩短一半
	track.custom_minimum_size = Vector2(manager.BAR_SIZE.x * 0.5, manager.BAR_SIZE.y)
	parent.add_child(track)
	
	return {"fill": track, "num": track.num_label, "row": track}

func _make_texture_icon(path: String, fallback: Control) -> Control:
	if not FileAccess.file_exists(path): return fallback
	var tex: Texture2D = load(path)
	if tex == null: return fallback
	var t := TextureRect.new()
	t.texture = tex
	t.custom_minimum_size = Vector2(20, 20)
	t.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	t.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	return t

func _make_status_icon(parent: Control, color: Color, _tip: String) -> Panel:
	var icon := Panel.new()
	icon.custom_minimum_size = Vector2(24, 24)
	icon.add_theme_stylebox_override("panel", _make_style(color, color.darkened(0.4), 1))
	parent.add_child(icon)
	return icon

func _make_style(bg: Color, border: Color, bw: int, radius: int = 6) -> StyleBoxFlat:
	var st := StyleBoxFlat.new()
	st.bg_color = bg; st.border_color = border
	st.set_border_width_all(bw); st.set_corner_radius_all(radius)
	st.shadow_color = Color(0, 0, 0, 0.18); st.shadow_size = 5; st.shadow_offset = Vector2(0, 2)
	return st
