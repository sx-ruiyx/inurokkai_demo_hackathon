extends Control
class_name UIHUD

var manager
var hp_fill: Control
var bp_fill: Control
var shield_fill: Control                   
var hp_label: Label
var bp_label: Label
var shield_label: Label
var bp_regen_label: Label 
var burn_icon: Control
var burn_text: Label
var quick_bar: HBoxContainer
var gold_label: Label
var level_label: Label
var slot_cd: Array[float] = [0.0, 0.0, 0.0, 0.0]

var bars_root: Control
var burn_root: VBoxContainer
var pause_btn_node: Button
var vn_mode: bool = false

var hp_row_box: Control
var shield_row_box: Control
var bp_row_box: Control

var is_burning: bool = false
var last_hp: int = -1
var last_shield: int = -1
var last_bp: int = -1

var _target_alpha := {"hp": 1.0, "shield": 1.0, "bp": 1.0}
var _alpha_tweens := {"hp": null, "shield": null, "bp": null}

const FADE_OUT_ALPHA := 0.3

func bind_manager(m) -> void:
	manager = m

func set_burning(state: bool) -> void:
	is_burning = state
	if burn_icon: burn_icon.visible = is_burning
	if burn_text: burn_text.visible = is_burning

func set_vn_mode(is_vn: bool) -> void:
	if vn_mode == is_vn: return
	vn_mode = is_vn
	if bars_root: bars_root.visible = not is_vn
	if quick_bar: quick_bar.visible = not is_vn
	if burn_root: burn_root.visible = not is_vn
	if pause_btn_node: pause_btn_node.visible = true

func _ready() -> void:
	mouse_filter = Control.MOUSE_FILTER_IGNORE
	_build_game_hud()
	_show_combat_guide_once()

## v1.12 战斗操作教学：首次进入关卡显示，12 秒后淡出（存档去重）
func _show_combat_guide_once() -> void:
	if GameState.tutorial_seen.get("combat", false): return
	var panel := Panel.new()
	panel.set_anchors_preset(Control.PRESET_CENTER_BOTTOM)
	panel.offset_left = -360.0; panel.offset_right = 360.0
	panel.offset_top = -132.0; panel.offset_bottom = -28.0
	panel.add_theme_stylebox_override("panel", manager._make_style(Color(0.10, 0.11, 0.15, 0.88), manager.COL_ACCENT, 2))
	add_child(panel)

	var vb := VBoxContainer.new()
	vb.add_theme_constant_override("separation", 4)
	vb.set_anchors_preset(Control.PRESET_FULL_RECT)
	vb.offset_left = 16; vb.offset_right = -16
	vb.offset_top = 10; vb.offset_bottom = -10
	panel.add_child(vb)

	var title := Label.new()
	title.text = "⚔️ 战斗操作"
	title.add_theme_color_override("font_color", manager.COL_ACCENT)
	UITextBox.apply_basic(title, "bold", 18)
	vb.add_child(title)

	var lines := [
		"A / D 移动 · Space 跳跃 · 空中 S 下蹲（落地冲击波）",
		"J 攻击（轻按三连击；按住蓄力斩）· Shift 或双击 A/D 冲刺",
		"冲刺中按 J = 冲刺攻击（高伤）· 1/2/3/4 释放技能（耗 BP）",
		"C 背包（装备技能/武器）· E 交互 · Esc 暂停",
	]
	for s in lines:
		var l := Label.new()
		l.text = s
		l.add_theme_color_override("font_color", manager.COL_TEXT)
		UITextBox.apply_basic(l, "normal", 14)
		vb.add_child(l)

	var t := create_tween()
	t.tween_interval(12.0)
	t.tween_property(panel, "modulate:a", 0.0, 1.5)
	t.tween_callback(func():
		GameState.tutorial_seen["combat"] = true
		panel.queue_free()
	)

