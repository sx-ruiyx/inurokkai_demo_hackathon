const ENTRIES := {
	"新手史莱姆": {"desc": "森林里最常见的软泥怪，智力低下但黏性惊人。木屋周边的常客。", "ch": "序章"},
	"训练用木桩": {"desc": "老猎人留下的练习靶，任你打骂绝不还手——当然也绝不会掉什么好东西。", "ch": "序章"},
	"苔骨": {"desc": "披着苔藓的骸骨哨兵，守护着森林深处的古老碑林。", "ch": "第一章"},
	"吞碑者": {"desc": "木屋森林深处的巨型史莱姆，以古老石碑为食。血量过半时会进入狂暴，咆哮着喷出三连泥弹。", "ch": "第一章"},
	"荆棘史莱姆": {"desc": "吞噬荆棘后变异的史莱姆，表刺尖锐。发动突进前身体会泛出琥珀色——那是蓄力的信号。", "ch": "第一章"},
	"荆棘之母": {"desc": "密林巢穴的统治者，荆棘史莱姆的源头。血量过半时会进入狂暴，喷射三连荆棘弹。", "ch": "第一章"},
	"沙珠": {"desc": "由沙粒聚合而成的漂浮眼球，会保持距离发射直线沙弹。", "ch": "第二章"},
	"流沙蛮兵": {"desc": "被流沙诅咒的蛮兵，见人就撞。靠近后会被它引爆同归于尽——千万别让它贴身。", "ch": "第二章"},
	"沙暴之核": {"desc": "沙暴风眼深处孕育的核心，绿洲之主。狂暴时移速大增，沙弹如暴雨。", "ch": "第二章"},
	"霜珠": {"desc": "极寒凝成的霜珠，触碰即冻结血液。突进前同样会闪烁蓄力。", "ch": "第三章"},
	"虚空游灵": {"desc": "来自虚空裂隙的游灵，本体孱弱却能源源不断召唤虚空造物。优先击杀本体。", "ch": "第三章"},
	"回响之冠": {"desc": "霜峰之巅的虚空王冠，承载着犬六回千百年轮回的全部记忆与悔恨。", "ch": "第三章"},
}

static func entry_for(name: String) -> Dictionary:
	return ENTRIES.get(name, {})

static func total() -> int:
	return ENTRIES.size()
